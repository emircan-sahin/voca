PORT=3100
BASE_URL=http://localhost:3100/api
MONGODB_URI=mongodb://localhost:27017/voca
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
# Reverse proxies in front of the server: 0 for direct, a hop count (e.g. 1 behind a load balancer),
# or 'cloudflare' to take the visitor IP from Cloudflare's CF-Connecting-IP header
TRUST_PROXY=0
# Max minutes of audio each user can transcribe per UTC day (resets at midnight UTC)
DAILY_AUDIO_LIMIT_MINUTES=180

GROQ_API_KEY=your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
XAI_API_KEY=your_xai_api_key_here

JWT_SECRET=your_jwt_secret_min_32_chars_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_CLIENT_TOKEN=your_paddle_client_token_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
PADDLE_PRICE_PRO=pri_your_pro_price_id_here
PADDLE_PRICE_MAX=pri_your_max_price_id_here
PADDLE_SANDBOX=true